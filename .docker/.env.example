# ----------------------------------------
# Docker compose project name
# ----------------------------------------
#
# Used by docker-compose for internal network creation
# ----------------------------------------
COMPOSE_PROJECT_NAME=winnery--space-rocket--frontend

# ----------------------------------------
# Application
# ----------------------------------------
#
# Application port
# Application version. Used as tag for docker image. Can be git tab, branch or commit
# ----------------------------------------
APP_VERSION=v0.0.0
APP_EXTERNAL_PORT=24280

# ----------------------------------------
# Analytics trackers
# ----------------------------------------
#
# Set identifier of sentry.io
# Set identifier of Yandex.Metrika
# Set identifier of Google Analytics
# ----------------------------------------
SENTRY_DSN=
YANDEX_METRIKA_ID=
GOOGLE_ANALYTICS_ID=
